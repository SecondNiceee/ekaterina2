# SMTP configuration for the "Второе мнение" (Second Opinion) form
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to "true" for implicit TLS (usually with port 465), otherwise "false"
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Address shown as the sender (defaults to SMTP_USER if empty)
SMTP_FROM=noreply@example.com
# Address that receives the form submissions (defaults to SMTP_USER if empty)
MAIL_TO=doctor@example.com

NEXT_PUBLIC_BASE_URL=https://smartcardio.ru/ekaterina
NEXT_PUBLIC_BASE_PATH=/ekaterina
